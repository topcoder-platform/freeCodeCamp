FROM node:26.12.1-bookworm AS builder
WORKDIR /source
ENV CYPRESS_INSTALL_BINARY=0 NPM_CONFIG_LEGACY_PEER_DEPS=true NPM_CONFIG_INSTALL_LINKS=true
COPY . .
RUN npm ci --ignore-scripts --legacy-peer-deps \
    && node tools/legacy-compat/apply.cjs \
    && npx tsc -p config && npx tsc -p utils \
    && node deploy/write-public-config.cjs --build \
    && CLIENT_LOCALE=english CURRICULUM_LOCALE=english npm run build:curriculum \
    && npm run build:server \
    && node --test tools/minimatch-compat/index.test.cjs api-server/test/security.test.cjs \
    && rm config/env.json

FROM node:26.12.1-alpine3.24 AS dependencies
ENV NPM_CONFIG_INSTALL_LINKS=true CYPRESS_INSTALL_BINARY=0
WORKDIR /app
COPY package.json package-lock.json ./
COPY api-server/package.json api-server/package.json
COPY tools/minimatch-compat tools/minimatch-compat
COPY tools/file-type-compat tools/file-type-compat
COPY tools/proxy-agent-compat tools/proxy-agent-compat
COPY tools/decode-uri-component-compat tools/decode-uri-component-compat
COPY tools/legacy-compat tools/legacy-compat
COPY tools/disabled-direct-mail tools/disabled-direct-mail
RUN npm ci --omit=dev --workspace=api-server --include-workspace-root=false --ignore-scripts --legacy-peer-deps \
    && node tools/legacy-compat/apply.cjs \
    && mkdir -p api-server/node_modules

FROM alpine:3.24
RUN apk upgrade --no-cache && apk add --no-cache 'nodejs-current~26' ca-certificates \
    && addgroup -S -g 10001 app && adduser -S -D -u 10001 -G app app
ENV NODE_ENV=production FREECODECAMP_NODE_ENV=production HOST=0.0.0.0 PM2_HOME=/tmp/pm2
WORKDIR /app
COPY --from=builder --chown=app:app /source/api-server/lib/ api-server/lib/
COPY --chown=app:app api-server/ecosystem.config.js api-server/
COPY --from=builder --chown=app:app /source/utils/ utils/
COPY --from=builder --chown=app:app /source/config/ config/
COPY --from=dependencies --chown=app:app /app/api-server/node_modules/ api-server/node_modules/
COPY --from=dependencies --chown=app:app /app/node_modules/ node_modules/
COPY --chown=app:app deploy/write-public-config.cjs deploy/write-public-config.cjs
COPY --chown=app:app deploy/start-api.sh deploy/start-api.sh
WORKDIR /app/api-server
USER app
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||3000)+'/status/ping').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/bin/sh", "/app/deploy/start-api.sh"]
